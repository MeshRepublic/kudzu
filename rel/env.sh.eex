#!/bin/sh

# Sourced by the release start script (bin/kudzu) before it resolves the
# distribution cookie.
#
# The cookie must come from the RELEASE_COOKIE environment variable. Without
# this check the start script would silently fall back to releases/COOKIE, a
# value baked into the build artifact at `mix release` time. Fail loudly
# instead. `version` and `eval` do not use distribution and are exempt.
case "$RELEASE_COMMAND" in
  version | eval) ;;
  *)
    if [ -z "${RELEASE_COOKIE:-}" ]; then
      echo "kudzu: RELEASE_COOKIE is not set; refusing to run '$RELEASE_COMMAND'." >&2
      echo "kudzu: export RELEASE_COOKIE (the same value on every node) and retry." >&2
      exit 1
    fi
    ;;
esac
