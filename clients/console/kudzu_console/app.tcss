Screen { layout: vertical; }
#status-header { height: 1; padding: 0 1; background: $primary-darken-2; color: $text; text-style: bold; }
#tabs { height: 3; }
#views { height: 1fr; }
#views > Widget { height: 1fr; }
#footer-hints { height: 1; padding: 0 1; background: $surface; color: $text-muted; }
/* Below 80 columns the app gets the `narrow` class; views stack their columns vertically against it. */

/* Chat view */
ChatView { layout: horizontal; }
#chat-sidebar { width: 30; border-right: tall $primary-darken-2; padding: 0 1; }
#chat-sidebar-title { text-style: bold; }
#backends { height: 1fr; }
#backends Checkbox { height: 1; width: 100%; padding: 0; border: none; }
#chat-meta { height: 1; color: $text-muted; }
#chat-main { width: 1fr; }
#conversation { height: 1fr; padding: 0 1; }
#conversation > Static, #conversation > Markdown { height: auto; }
#conversation .user { text-style: bold; margin-top: 1; }
#conversation .label { color: $accent; text-style: bold; }
#conversation .status, #conversation .note, #conversation .welcome { color: $text-muted; }
#conversation .error { color: $error; }
#chat-input { height: auto; min-height: 3; max-height: 8; }
.narrow ChatView { layout: vertical; }
.narrow #chat-sidebar { width: 100%; height: 8; border-right: none; border-bottom: tall $primary-darken-2; }
.narrow #chat-main { height: 1fr; width: 100%; }

/* Proposals view */
#proposals-body { height: 1fr; }
#proposals-main { width: 1fr; padding: 0 1; }
#proposal-input { width: 100%; }
#principle-select { width: 100%; }
#message { color: $error; height: auto; }
#banner { height: auto; background: $warning; color: $text; padding: 0 1; text-style: bold; }
#verdict { height: auto; margin-top: 1; text-style: bold; }
#stages { height: auto; margin-top: 1; }
#stages .stage-row { height: auto; }
#stages .dim { color: $text-muted; text-style: dim; }
#vote-row { height: auto; margin-top: 1; }
#vote-row Button { margin-right: 1; }
#vote-status { height: auto; }
#history { width: 44; border-left: tall $primary-darken-2; }
.narrow #proposals-body { layout: vertical; }

/* Antitrust view */
#antitrust-body { height: 1fr; }
#scenario { width: 1fr; padding: 0 1; }
#result-panel { width: 1fr; padding: 0 1; border-left: tall $primary-darken-2; }
#presets-title { text-style: bold; }
#presets { height: auto; grid-size: 2; grid-rows: 1; grid-gutter: 0 1; }
#presets Button { width: 100%; }
.field-row { height: 1; }
.field-label { width: 16; }
.field-row Input { width: 1fr; }
.field-row Input.invalid { background: $error 30%; }
.field-error { width: 22; color: $error; padding-left: 1; }
#defaults-note { height: auto; color: $warning; }
#antitrust-body #evaluate { margin-top: 1; }
#antitrust-body #message { color: $error; height: auto; }
#result { height: auto; text-style: bold; }
.narrow #antitrust-body { layout: vertical; }
.narrow #scenario, .narrow #result-panel { width: 100%; }
.narrow #scenario { height: 2fr; }
.narrow #result-panel { height: 1fr; border-left: none; border-top: tall $primary-darken-2; }
